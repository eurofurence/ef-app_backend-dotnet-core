@using Eurofurence.App.Backoffice.Services
@using Eurofurence.App.Domain.Model.Images

@inject IImageService ImageService

<MudPaper Class="d-flex flex-column align-center">
    @if (!IsUploading)
    {
        @if (string.IsNullOrEmpty(ImageResponse?.Url))
        {
            <MudPaper Class="d-flex align-center justify-center" Style="width: 500px; height: 500px;">
                <MudText>Upload Image here</MudText>
            </MudPaper>
        }
        else
        {
            <MudLink Href="@ImageResponse?.Url" Class="d-flex justify-center">
                <MudImage Fluid="true" Width="500" Height="500" ObjectFit="ObjectFit.Contain" Src="@ImageResponse?.Url"
                          Elevation="25" Class="rounded-lg"/>
            </MudLink>
        }
    }
    else
    {
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="500px" Height="500px" Class="d-flex justify-center rounded-lg" >
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="d-flex align-center justify-center" />
        </MudSkeleton>

    }

    @if(!HideRemoveButton)
    {
        <MudGrid>
            <MudItem xl="6" md="6">
                <MudFileUpload T="IBrowserFile" Disabled="IsUploading || Disabled" FilesChanged="UploadImage" Style="margin-top: 10px;" />
            </MudItem>
            <MudItem xl="6" md="6">
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="IsUploading || Disabled" OnClick="ClearImage" FullWidth="true" Style="margin-top: 10px;">
                    Remove
                </MudButton>
            </MudItem>
        </MudGrid>
    }
    else
    {
        <MudFileUpload T="IBrowserFile" Disabled="IsUploading || Disabled" FilesChanged="UploadImage" Style="margin-top: 10px;" />
    }
</MudPaper>

@code {

    /// <summary>
    /// The image that is currently being displayed.
    /// </summary>
    [Parameter]
    public ImageResponse? ImageResponse { get; set; }

    /// <summary>
    /// Event raised when the image upload is started.
    /// </summary>
    [Parameter]
    public EventCallback UploadStarted { get; set; }

    /// <summary>
    /// Event raised when the image is changed.
    /// </summary>
    [Parameter]
    public EventCallback<ImageResponse?> ImageChanged { get; set; }

    /// <summary>
    /// Event raised when the image upload fails.
    /// TODO: pass error message
    /// </summary>
    [Parameter]
    public EventCallback ImageUploadError { get; set; }

    /// <summary>
    /// Disables upload and remove buttons.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Determines whether the remove button should be hidden.
    /// </summary>
    [Parameter]
    public bool HideRemoveButton { get; set; }

    private bool IsUploading;

    /// <summary>
    /// Uploads the image to the server.
    /// </summary>
    /// <param name="file">The file to upload.</param>
    private async Task UploadImage(IBrowserFile? file)
    {
        if (file is null)
        {
            return;
        }

        IsUploading = true;
        await UploadStarted.InvokeAsync();

        StateHasChanged();

        try
        {
            ImageResponse? image = await ImageService.PostImageAsync(file);

            if (image is null)
            {
                await ImageUploadError.InvokeAsync();
                return;
            }

            ImageResponse = image;
            await ImageChanged.InvokeAsync(image);
            IsUploading = false;
            StateHasChanged();
        }
        catch
        {
            await ImageUploadError.InvokeAsync();
        }
        finally
        {
            IsUploading = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Removes the image.
    /// </summary>
    private async Task ClearImage()
    {
        if (ImageResponse is null)
        {
            return;
        }

        ImageResponse = null;
        await ImageChanged.InvokeAsync(null);
        StateHasChanged();
    }
}