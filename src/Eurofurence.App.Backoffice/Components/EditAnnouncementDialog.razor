@using Eurofurence.App.Backoffice.Services
@using Eurofurence.App.Domain.Model.Announcements

@inject IAnnouncementService AnnouncementService
@inject IImageService ImageService
@inject ISnackbar Snackbar

<MudPaper Class="pa-4">
    <MudDialog>
        <DialogContent>
            @if (Announcement != null)
            {
                <MudForm @ref="_form" @bind-IsValid="@_formIsValid" Class="">
                    <MudGrid>
                        <MudItem xl="6" md="6" xs="12">
                            <MudTextField Class="mt-2" T="string" @bind-Value="_title" Required="true"
                                          RequiredError="Name is required." Label="Title"/>
                        </MudItem>
                        <MudItem xl="6" md="6" xs="12">
                            <MudTextField Class="mt-2" T="string" @bind-Value="_author" Required="true"
                                          RequiredError="Author is required." Label="Author"/>
                        </MudItem>
                        <MudItem xl="6" md="6" xs="12">
                            <MudTextField Class="mt-2" T="string" @bind-Value="_area" Required="true"
                                          RequiredError="Area is required." Label="Area"/>
                        </MudItem>
                        <MudItem xl="6" md="6" xs="12">
                            <MudTextField Class="mt-2" T="string" @bind-Value="_content" Required="true"
                                          RequiredError="Content is required." AutoGrow Label="Content"
                                          HelperText="Supports multiple lines."/>
                        </MudItem>
                        <MudItem xl="6" md="6" xs="12">
                            <MudDatePicker Label="End Date" Required="true" @bind-Date="_endDate"/>
                        </MudItem>
                        <MudItem xl="6" md="6" xs="12">
                            <MudTimePicker Label="End Time" Required="true" @bind-Time="_endTime"/>
                        </MudItem>
                    </MudGrid>

                    <MudTextField Label="Groups (comma separated)" @bind-Value="_groups"/>
                    <MudTextField Label="Image ID" Validation="@(new Func<string, Task<string>>(ValidateImageId))"
                                  @bind-Value="_imageId"/>
                </MudForm>
            }
        </DialogContent>
        <DialogActions>
            <MudButton Color="Color.Secondary" OnClick="@OnClickedCancel">Cancel</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@_submissionInProgress"
                       OnClick="@OnClickedSubmit">
                @if (_submissionInProgress)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                    <MudText Class="ms-2">Processing</MudText>
                }
                else
                {
                    <MudText>Submit</MudText>
                }
            </MudButton>
        </DialogActions>
    </MudDialog>
</MudPaper>

@code {

    #region Attributes

    /// <summary>
    /// The announcement to edit.
    /// </summary>
    [Parameter]
    public AnnouncementResponse? Announcement { get; set; }

    /// <summary>
    /// Dialog instance for MudBlazor dialog.
    /// </summary>
    ///
    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    /// <summary>
    /// The title of the announcement.
    /// </summary>
    private string? _title;

    /// <summary>
    /// The author of the announcement.
    /// </summary>
    private string? _author;

    /// <summary>
    /// The area of the announcement.
    /// </summary>
    private string? _area;

    /// <summary>
    /// The content of the announcement.
    /// </summary>
    private string? _content;

    /// <summary>
    /// The ID of the image.
    /// </summary>
    private string? _imageId;

    /// <summary>
    /// The date until the announcement should be valid.
    /// </summary>
    private DateTime? _endDate;

    /// <summary>
    /// The time until the announcement should be valid.
    /// </summary>
    private TimeSpan? _endTime;

    /// <summary>
    /// Groups (IDP groups) which the announcement should be sent to.
    /// </summary>
    private string _groups = "";

    /// <summary>
    /// Specifies whether the form is valid or not.
    /// </summary>
    private bool _formIsValid;

    /// <summary>
    /// Instance of the MudForm component used for validation.
    /// </summary>
    private MudForm? _form;

    /// <summary>
    /// Whether a submission is currently in progress.
    /// </summary>
    private bool _submissionInProgress;

    #endregion

    #region Methods

    protected override void OnParametersSet()
    {
        _title = Announcement?.Title;
        _author = Announcement?.Author;
        _area = Announcement?.Area;
        _content = Announcement?.Content;
        _imageId = Announcement?.ImageId.ToString();
        _endDate = Announcement?.ValidUntilDateTimeUtc.Date;
        _endTime = Announcement?.ValidUntilDateTimeUtc.TimeOfDay;
        _groups = string.Join(",", Announcement?.Groups ?? Array.Empty<string>());
    }

    protected override void OnInitialized()
    {
        _endDate = Announcement?.ValidUntilDateTimeUtc.Date;
        _endTime = Announcement?.ValidUntilDateTimeUtc.TimeOfDay;
        _groups = string.Join(",", Announcement?.Groups ?? Array.Empty<string>());
    }

    /// <summary>
    /// Is called when the cancel button is clicked.
    /// This will close the dialog.
    /// </summary>
    private void OnClickedCancel()
    {
        MudDialog?.Close(DialogResult.Cancel());
    }

    /// <summary>
    /// Called when the Submit button is clicked.
    /// This will send the announcement request to the server if valid.
    /// </summary>
    /// <param name="obj">Event object. Not used here.</param>
    private async Task OnClickedSubmit(MouseEventArgs obj)
    {
        if (Announcement is null)
        {
            Snackbar.Add("Announcement is not loaded.", Severity.Error);
            return;
        }

        if (_form is null)
        {
            Snackbar.Add("Form is not ready.", Severity.Error);
            return;
        }

        await _form.ValidateAsync();

        if (!_formIsValid)
        {
            Snackbar.Add("Form is invalid. Please check the validation errors.", Severity.Error);
            return;
        }

        if (_endTime == null)
        {
            Snackbar.Add("End time is required.", Severity.Error);
            return;
        }

        DateTime? endDateTime = _endDate?.Date + _endTime.Value;

        if (endDateTime == null)
        {
            Snackbar.Add("End time is required.", Severity.Error);
            return;
        }

        AnnouncementRequest request = new()
        {
            Title = _title,
            Author = _author,
            Area = _area,
            Content = _content,
            ImageId = Guid.TryParse(_imageId, out Guid parsedImageId) ? parsedImageId : null,
            ValidUntilDateTimeUtc = endDateTime.Value,
            Groups = _groups
                .Split(",", StringSplitOptions.RemoveEmptyEntries)
                .Select(role => role.Trim())
                .Where(role => role.Length > 0)
                .ToArray()
        };

        try
        {
            _submissionInProgress = true;
            await AnnouncementService.UpdateAnnouncementAsync(Announcement.Id, request);
            Snackbar.Add("Announcement successfully submitted", Severity.Success);
            MudDialog?.Close(DialogResult.Ok(request));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error submitting announcement: {ex.Message}", Severity.Error);
        }
        finally
        {
            _submissionInProgress = false;
        }
    }

    #endregion

    /// <summary>
    /// Validates the image ID.
    /// ID must be a valid GUID when set, and the image must exist in the database.
    /// </summary>
    /// <param name="arg">The image id to validate.</param>
    /// <returns>Optional error message.</returns>
    private async Task<string?> ValidateImageId(string? arg)
    {
        if (string.IsNullOrWhiteSpace(arg))
        {
            return null; // ImageId is optional
        }

        if (!Guid.TryParse(arg, out var imageId))
        {
            return "Image ID must be a valid GUID.";
        }

        try
        {
            var image = await ImageService.GetImageAsync(imageId);
            return image is null ? "Image not found." : null;
        }
        catch (HttpRequestException)
        {
            return "Image not found.";
        }
    }

}
