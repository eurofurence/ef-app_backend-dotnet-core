@page "/Announcements"
@using Eurofurence.App.Backoffice.Components
@using Eurofurence.App.Backoffice.Services
@using Eurofurence.App.Domain.Model.Announcements
@using Eurofurence.App.Domain.Model.Identity
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = $"{IdentityRoles.Admin},{IdentityRoles.AnnouncementManager}")]
@inject IAnnouncementService AnnouncementService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudToolBar>
    <MudText Typo="Typo.h6">Announcements</MudText>
    <MudSpacer />
</MudToolBar>

<MudDataGrid T="AnnouncementResponse" @ref="_dataGrid" Items="_items" Filterable="true"
    FilterMode="@DataGridFilterMode.ColumnFilterMenu">
    <Columns>
        <PropertyColumn Title="Title" Property="arg => arg.Title"></PropertyColumn>
        <PropertyColumn Title="Author" Property="arg => arg.Author"></PropertyColumn>
        <PropertyColumn Title="Area" Property="arg => arg.Area"></PropertyColumn>
        <PropertyColumn Title="Content" Property="arg => arg.Content"></PropertyColumn>
        <PropertyColumn Title="ValidFromDateTimeUtc" Property="arg => arg.ValidFromDateTimeUtc"></PropertyColumn>
        <PropertyColumn Title="ValidUntilDateTimeUtc" Property="arg => arg.ValidUntilDateTimeUtc"></PropertyColumn>
        <PropertyColumn Title="LastChangeDateTimeUtc" Property="arg => arg.LastChangeDateTimeUtc"></PropertyColumn>
        <TemplateColumn>
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => OnClickEdit(context.Item))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(() => OnClickDelete(context.Item))"></MudIconButton>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="AnnouncementResponse" />
    </PagerContent>
</MudDataGrid>

@code {
    
    private MudDataGrid<AnnouncementResponse> _dataGrid = null!;
    
    /// <summary>
    /// A collection of the loaded announcements to display in the data grid.
    /// </summary>
    private IEnumerable<AnnouncementResponse> _items = new List<AnnouncementResponse>();

    private async Task OnClickDelete(AnnouncementResponse contextItem)
    {
        DialogParameters<ConfirmDialog> dialogUserban = new()
        {
            {
                x => x.ContentText, "Are you sure you want to delete this announcement?"
            },
        };

        var optionsUserBan = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.ExtraSmall
        };

        IDialogReference dialogRef = await DialogService.ShowAsync<ConfirmDialog>("Confirm", dialogUserban, optionsUserBan);
        DialogResult? result = await dialogRef.Result;

        if (result is { Canceled: false })
        {
            try
            {
                await AnnouncementService.DeleteAnnouncementAsync(contextItem.Id);
                await LoadAnnouncementsAsync();
                Snackbar.Add("Announcement deleted", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting announcement: {ex.Message}", Severity.Error);
            }
        }
    }
    
    /// <summary>
    /// Is called when the "Edit" button is clicked.
    /// </summary>
    /// <param name="item">Item the user has clicked on.</param>
    private async Task OnClickEdit(AnnouncementResponse item)
    {
        DialogOptions options = new()
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true,
            CloseButton = true
        };

        DialogParameters<AnnouncementDialog> parameters = new()
        {
            {x => x.Announcement, item}
        };
        
        IDialogReference dialog = await DialogService.ShowAsync<AnnouncementDialog>("Edit Announcement", parameters, options);
        DialogResult? result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAnnouncementsAsync();
        }
    }

    /// <summary>
    /// Called after the component has rendered.
    /// Will load the announcements from the service if this is the first render.
    /// </summary>
    /// <param name="firstRender">Specifies if the component is rendered for the first time.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            await LoadAnnouncementsAsync();
            await _dataGrid.SetSortAsync(nameof(AnnouncementResponse.ValidFromDateTimeUtc), SortDirection.Descending, x => x.ValidFromDateTimeUtc);
        }
    }
    
    /// <summary>
    /// Loads the announcements.
    /// </summary>
    private async Task LoadAnnouncementsAsync()
    {
        try
        {
            _items = await AnnouncementService.GetAnnouncementsAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading announcements: {ex.Message}", Severity.Error);
        }
    }
}
