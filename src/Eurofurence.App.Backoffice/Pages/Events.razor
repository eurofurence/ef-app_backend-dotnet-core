@page "/events"
@attribute [Authorize(Roles = "Admin,EventArtworkManager,EventFeedbackManager")]
@using System.Security.Claims;
@using Eurofurence.App.Backoffice.Components
@using Eurofurence.App.Backoffice.Services
@using Microsoft.AspNetCore.Authorization
@using Eurofurence.App.Domain.Model.Events
@using Eurofurence.App.Domain.Model.Users
@inject IEventService EventService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider

<MudToolBar>
    <MudText Typo="Typo.h6">Events</MudText>
    <MudSpacer />
    <MudToggleGroup T="Guid?" Color="Color.Primary" Value="_selectedEventConferenceDayId" ValueChanged="EventConferenceDayChanged" Class="mt-1">
        <MudToggleItem T="Guid?" Value="@(null)">All</MudToggleItem>
        @foreach (var day in _eventConferenceDays)
        {
            <MudToggleItem T="Guid?" Value="@day.Id">@day.Date.ToString("ddd")</MudToggleItem>
        }
    </MudToggleGroup>
    <MudTextField Class="ml-4" T="string" ValueChanged="Search" Clearable="true" Label="Search" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" AdornmentColor="Color.Secondary" />
</MudToolBar>

<MudDataGrid T="EventResponse" Items="@_events" LoadingProgressColor="Color.Primary"
             SortMode="@SortMode.Multiple" Groupable="false">
    <Columns>
        <PropertyColumn Title="ID" Property="e => e.Id" />
        <PropertyColumn Title="Title" Property="e => e.Title" />
        <TemplateColumn Title="Description">
            <CellTemplate>
                <div class="d-flex align-center gap-2">
                    <MudTooltip Text="@context.Item.Description" Disabled="@(string.IsNullOrEmpty(context.Item.Description))">
                        <ChildContent>
                            <div style="max-width:150px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                @context.Item.Description
                            </div>
                        </ChildContent>
                        <TooltipContent>
                            <div style="max-width:300px;">
                                @context.Item.Description
                            </div>
                        </TooltipContent>
                    </MudTooltip>
                </div>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Title="Slug" Property="e => e.Slug" />
        <PropertyColumn Title="Start Time" Property="e => e.StartDateTimeUtc" Format="yyyy-MM-dd HH:mm (ddd) zzz" />
        <PropertyColumn Title="Duration" Property="e => e.Duration" Format="hh\:mm" />

        <AuthorizeView Roles="Admin,EventFeedbackManager">
            <Authorized>
                <TemplateColumn Context="favoritesTotalContext" Sortable="true" SortBy="e => (e as EventWithStatisticsResponse)?.FavoriteStatistics?.Sum(s => s.Count) ?? 0">
                    <HeaderTemplate>
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" />
                            <MudText>
                                Total
                            </MudText>
                        </div>
                    </HeaderTemplate>
                    <CellTemplate>
                        <div class="d-flex align-center gap-2">
                            <MudText>
                                @if (favoritesTotalContext.Item is EventWithStatisticsResponse eventWithStats)
                                {
                                    @eventWithStats.FavoriteStatistics.Sum(s => s.Count)
                                }
                                else
                                {
                                    @(0)
                                }
                            </MudText>

                            @if (favoritesTotalContext.Item.StartDateTimeUtc < DateTime.UtcNow)
                            {
                                <MudTooltip Text="Event has started. Favorite counter is locked since the start time." Class="mt-1">
                                    <MudIcon Icon="@Icons.Material.Filled.LockClock" Size="Size.Small" Color="Color.Secondary" />
                                </MudTooltip>
                            }
                        </div>
                    </CellTemplate>
                </TemplateColumn>
        
                <TemplateColumn Context="favoritesByStatusContext" HeaderStyle="min-width: 150px;" Sortable="true" SortBy="e => (e as EventWithStatisticsResponse)?.FavoriteStatistics?.FirstOrDefault(s => s.UserRegistrationStatus == UserRegistrationStatus.CheckedIn)?.Count ?? 0">
                    <HeaderTemplate>
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" />
                            <MudSelect Required="true" T="UserRegistrationStatus" @bind-Value="_selectedUserRegistrationStatus" FullWidth="true">
                                @foreach (var status in Enum.GetValues<UserRegistrationStatus>())
                                {
                                    <MudSelectItem T="UserRegistrationStatus" Value="@status"></MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                    </HeaderTemplate>
                    <CellTemplate>
                        <div class="d-flex align-center gap-2">
                        <MudText>
                                @if (favoritesByStatusContext.Item is EventWithStatisticsResponse eventWithStats)
                                {
                                    @eventWithStats.FavoriteStatistics.FirstOrDefault(s => s.UserRegistrationStatus == _selectedUserRegistrationStatus)?.Count
                                }
                        </MudText>

                            @if (favoritesByStatusContext.Item.StartDateTimeUtc < DateTime.UtcNow)
                        {
                            <MudTooltip Text="Event has started. Favorite count is locked since the start time." Class="mt-1">
                                <MudIcon Icon="@Icons.Material.Filled.LockClock" Size="Size.Small" Color="Color.Secondary" />
                            </MudTooltip>
                        }
                    </div>
                    </CellTemplate>
                </TemplateColumn>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Admin,EventArtworkManager">
            <Authorized>
                <TemplateColumn Context="actionsContext">
                    <CellTemplate>
                        <MudButtonGroup>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="() => OnClickEdit(actionsContext.Item)" />
                        </MudButtonGroup>
                    </CellTemplate>
                </TemplateColumn>
            </Authorized>
        </AuthorizeView>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="EventResponse" />
    </PagerContent>
</MudDataGrid>

@code {
    private string? _eventSearch;
    private List<EventResponse> _events = new();
    private List<EventConferenceDayResponse> _eventConferenceDays = new();
    private Guid? _selectedEventConferenceDayId;
    private UserRegistrationStatus _selectedUserRegistrationStatus = UserRegistrationStatus.CheckedIn;

    private ClaimsPrincipal? User;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        User = authState.User;

        _events = await GetEventsAsync();
        _eventConferenceDays = await GetEventConferenceDays();
    }

    private async Task<List<EventResponse>> GetEventsAsync()
    {
        try
        {
            EventResponse[] response = [];

            if (User is not null && User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("EventFeedbackManager")))
            {
                response = await EventService.GetEventsWithStatisticsAsync();
            }
            else
            {
                response = await EventService.GetEventsAsync();
            }

            var responseOrdered = response.OrderBy(e => e.StartDateTimeUtc).ToList();
            return FilterEvents(responseOrdered, _eventSearch).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading events: {ex.Message}", Severity.Error);
        }

        return [];
    }

    private async Task<List<EventConferenceDayResponse>> GetEventConferenceDays()
        => (await EventService.GetEventConferenceDaysAsync()).OrderBy(day => day.Date).ToList();

    private async Task Search(string? searchString)
    {
        _eventSearch = searchString;
        _events = await GetEventsAsync();
    }

    private async Task EventConferenceDayChanged(Guid? selectedDayId)
    {
        _selectedEventConferenceDayId = selectedDayId;
        _events = await GetEventsAsync();
    }

    private IEnumerable<EventResponse> FilterEvents(IEnumerable<EventResponse> entries, string?
    searchString)
    {
        if (_selectedEventConferenceDayId is not null)
        {
            entries = entries.Where(entry => entry.ConferenceDayId == _selectedEventConferenceDayId);
        }

        return string.IsNullOrEmpty(searchString)
            ? entries
            : entries.Where(entry =>
                entry.Id.ToString().ToLower().Contains(searchString.ToLower())
                || (entry.Title is not null && entry.Title.ToLower().Contains(searchString.ToLower()))
                || (entry.SubTitle is not null && entry.SubTitle.ToLower().Contains(searchString.ToLower()))
                || (entry.Abstract is not null && entry.Abstract.ToLower().Contains(searchString.ToLower()))
                || (entry.Slug is not null && entry.Slug.ToLower().Contains(searchString.ToLower()))
                || (entry.Description is not null && entry.Description.ToLower().Contains(searchString.ToLower())));
    }

    /// <summary>
    /// Is called when the "Edit" button is clicked.
    /// </summary>
    /// <param name="item">Item the user has clicked on.</param>
    private async Task OnClickEdit(EventResponse item)
    {
        DialogOptions options = new()
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true,
            CloseButton = true
        };

        DialogParameters<EventDialog> parameters = new()
        {
            {x => x.Event, item}
        };

        IDialogReference dialog = await DialogService.ShowAsync<EventDialog>("Edit Event", parameters, options);
        DialogResult? result = await dialog.Result;

        if (result is { Canceled: false })
        {
            _events = await GetEventsAsync();
        }
    }
}